# Copy to .env.local for local work. Never commit real values: this repository
# is public, and .gitignore's blanket .env* rule is what keeps .env.local out
# of it. Only this example file is exempt.

# --- Vercel Web Analytics mirror -------------------------------------------
# A Vercel personal access token with read access. Create one at
# https://vercel.com/account/tokens
VERCEL_ANALYTICS_TOKEN=

# Project Settings -> General -> Project ID. This is a personal account
# project, so no team id is needed anywhere.
VERCEL_PROJECT_ID=

# --- Database ---------------------------------------------------------------
# Injected automatically in Vercel by the Neon marketplace integration. Set it
# by hand only for local work, using the connection string Neon shows.
DATABASE_URL=

# --- Cron -------------------------------------------------------------------
# Provided automatically by Vercel in deployed environments. Set it locally
# only if you want to call the sync endpoint by hand.
CRON_SECRET=

# --- Private dashboard ------------------------------------------------------
# The password for /insights. Make it long and random: the route is public
# knowledge because the source is, so this is the only thing protecting it.
ANALYTICS_PASSWORD=

# Random 32+ byte string used to sign the session cookie and to salt the daily
# visitor hash. Generate with: openssl rand -hex 32
ANALYTICS_SECRET=

# --- Local beacon testing ---------------------------------------------------
# The beacon writes only from production, because DATABASE_URL here points at
# the same database the deployed site uses and browsing localhost would
# otherwise file itself as real traffic. Set this to 1 to write from a local
# run anyway, when the point is to test the beacon itself. Never set it in
# Vercel.
ANALYTICS_ALLOW_LOCAL_BEACON=
